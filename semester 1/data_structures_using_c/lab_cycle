// Circular doubly linked list: insert end, delete first, display both directions
#include <stdio.h>
#include <stdlib.h>
struct node { int data; struct node *prev, *next; };
struct node *head = NULL;

int main() {
    int ch, x;
    struct node *t, *p;
    while (1) {
        printf("\n1.Insert end 2.Delete first 3.Display 4.Exit: ");
        scanf("%d", &ch);
        if (ch == 1) {
            printf("Value: ");
            scanf("%d", &x);
            t = (struct node *)malloc(sizeof(struct node));
            t->data = x;
            if (head == NULL) { t->next = t->prev = t; head = t; }
            else {
                t->next = head; t->prev = head->prev;
                head->prev->next = t; head->prev = t;
            }
        } else if (ch == 2) {
            if (head == NULL) printf("List empty\n");
            else {
                t = head;
                printf("Deleted %d\n", t->data);
                if (t->next == t) head = NULL;
                else { t->prev->next = t->next; t->next->prev = t->prev; head = t->next; }
                free(t);
            }
        } else if (ch == 3) {
            if (head == NULL) { printf("List empty\n"); continue; }
            printf("Forward : ");
            p = head;
            do { printf("%d ", p->data); p = p->next; } while (p != head);
            printf("\nBackward: ");
            p = head->prev;
            do { printf("%d ", p->data); p = p->prev; } while (p != head->prev);
            printf("\n");
        } else break;
    }
    return 0;
}

