// Deletion of a node in a singly linked list: first, last, by value
#include <stdio.h>
#include <stdlib.h>
struct node { int data; struct node *next; };
struct node *head = NULL;

void insert_end(int x) {
    struct node *t = (struct node *)malloc(sizeof(struct node)), *p;
    t->data = x; t->next = NULL;
    if (head == NULL) head = t;
    else { for (p = head; p->next; p = p->next); p->next = t; }
}
void display() {
    for (struct node *p = head; p; p = p->next) printf("%d -> ", p->data);
    printf("NULL\n");
}
int main() {
    int ch, x;
    struct node *p, *prev;
    while (1) {
        printf("\n1.Insert 2.Delete first 3.Delete last 4.Delete by value 5.Display 6.Exit: ");
        scanf("%d", &ch);
        if (ch == 1) { printf("Value: "); scanf("%d", &x); insert_end(x); }
        else if (ch == 2) {
            if (head == NULL) printf("List empty\n");
            else { p = head; head = head->next; free(p); }
        } else if (ch == 3) {
            if (head == NULL) printf("List empty\n");
            else if (head->next == NULL) { free(head); head = NULL; }
            else {
                for (p = head; p->next->next; p = p->next);
                free(p->next); p->next = NULL;
            }
        } else if (ch == 4) {
            printf("Value to delete: ");
            scanf("%d", &x);
            for (prev = NULL, p = head; p && p->data != x; prev = p, p = p->next);
            if (p == NULL) printf("Not found\n");
            else {
                if (prev == NULL) head = p->next;
                else prev->next = p->next;
                free(p);
            }
        } else if (ch == 5) display();
        else break;
    }
    return 0;
}

