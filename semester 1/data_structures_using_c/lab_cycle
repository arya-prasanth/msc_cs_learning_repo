    char e[50];
    printf("Enter postfix expression (no spaces): ");
    scanf("%s", e);
    for (int i = 0; e[i]; i++) {
        if (isdigit(e[i])) st[++top] = e[i] - '0';
        else {
            int b = st[top--], a = st[top--];
            if (e[i] == '+') st[++top] = a + b;
            else if (e[i] == '-') st[++top] = a - b;
            else if (e[i] == '*') st[++top] = a * b;
            else st[++top] = a / b;
        }
    }
    printf("Result = %d\n", st[top]);
    return 0;
}

