// Sort an array in ascending order - menu driven
#include <stdio.h>
int n, a[50], b[50];

void show() {
    for (int i = 0; i < n; i++) printf("%d ", b[i]);
    printf("\n");
}
void bubble() {
    for (int i = 0; i < n - 1; i++)
        for (int j = 0; j < n - i - 1; j++)
            if (b[j] > b[j + 1]) { int t = b[j]; b[j] = b[j + 1]; b[j + 1] = t; }
}
void selection() {
    for (int i = 0; i < n - 1; i++) {
        int m = i;
        for (int j = i + 1; j < n; j++) if (b[j] < b[m]) m = j;
        int t = b[i]; b[i] = b[m]; b[m] = t;
    }
}
void insertion() {
    for (int i = 1; i < n; i++) {
        int key = b[i], j = i - 1;
        while (j >= 0 && b[j] > key) { b[j + 1] = b[j]; j--; }
        b[j + 1] = key;
    }
}
int main() {
    int ch;
    printf("Enter n: ");
    scanf("%d", &n);
    printf("Enter elements: ");
    for (int i = 0; i < n; i++) scanf("%d", &a[i]);
    while (1) {
        printf("\n1.Bubble 2.Selection 3.Insertion 4.Exit: ");
        scanf("%d", &ch);
        if (ch == 4) break;
        for (int i = 0; i < n; i++) b[i] = a[i];   // sort a fresh copy each time
        if (ch == 1) bubble();
        else if (ch == 2) selection();
        else if (ch == 3) insertion();
        else continue;
        printf("Sorted: ");
        show();
    }
    return 0;
}

