// Array operations using functions: insert, delete, display
#include <stdio.h>
int a[50], n = 0;

void insert(int pos, int x) {
    for (int i = n; i >= pos; i--) a[i] = a[i - 1];
    a[pos - 1] = x;
    n++;
}
void del(int pos) {
    for (int i = pos - 1; i < n - 1; i++) a[i] = a[i + 1];
    n--;
}
void display() {
    for (int i = 0; i < n; i++) printf("%d ", a[i]);
    printf("\n");
}
int main() {
    int ch, pos, x;
    while (1) {
        printf("\n1.Insert 2.Delete 3.Display 4.Exit: ");
        scanf("%d", &ch);
        if (ch == 1) {
            printf("Position and value: ");
            scanf("%d %d", &pos, &x);
            if (pos < 1 || pos > n + 1 || n == 50) printf("Invalid\n");
            else insert(pos, x);
        } else if (ch == 2) {
            printf("Position: ");
            scanf("%d", &pos);
            if (pos < 1 || pos > n) printf("Invalid\n");
            else del(pos);
        } else if (ch == 3) display();
        else break;
    }
    return 0;
}

