// Infix to postfix conversion (operands: letters/digits; operators + - * / ^ and brackets)
#include <stdio.h>
#include <ctype.h>
char st[50];
int top = -1;

int prec(char c) {
    if (c == '^') return 3;
    if (c == '*' || c == '/') return 2;
    if (c == '+' || c == '-') return 1;
    return 0;                       // '(' has lowest precedence
}
int main() {
    char in[50], out[50];
    int k = 0;
    printf("Enter infix expression (no spaces): ");
    scanf("%s", in);
    for (int i = 0; in[i]; i++) {
        char c = in[i];
        if (isalnum(c)) out[k++] = c;
        else if (c == '(') st[++top] = c;
        else if (c == ')') {
            while (st[top] != '(') out[k++] = st[top--];
            top--;                  // discard '('
        } else {
            while (top >= 0 && (prec(st[top]) > prec(c) || (prec(st[top]) == prec(c) && c != '^')))
                out[k++] = st[top--];
            st[++top] = c;
        }
    }
    while (top >= 0) out[k++] = st[top--];
    out[k] = '\0';
    printf("Postfix: %s\n", out);
    return 0;
}

