// Demonstrates dynamic memory allocation: malloc, use, realloc, free
#include <stdio.h>
#include <stdlib.h>
int main() {
    int *p = (int *)malloc(3 * sizeof(int));        // allocate 3 ints
    if (p == NULL) { printf("Memory not allocated\n"); return 1; }
    for (int i = 0; i < 3; i++) p[i] = (i + 1) * 10;
    printf("Before: ");
    for (int i = 0; i < 3; i++) printf("%d ", p[i]);

    p = (int *)realloc(p, 5 * sizeof(int));         // grow to 5 ints
    p[3] = 40; p[4] = 50;
    printf("\nAfter realloc: ");
    for (int i = 0; i < 5; i++) printf("%d ", p[i]);
    printf("\n");
    free(p);                                        // release memory
    return 0;
}

