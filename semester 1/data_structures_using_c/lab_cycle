// Data structure operations and comparison: Stack (LIFO) vs Queue (FIFO) - menu driven
#include <stdio.h>
#define MAX 20
int s[MAX], q[MAX], top = -1, front = 0, rear = -1;

int main() {
    int ch, x;
    while (1) {
        printf("\n1.Insert 2.Delete 3.Display both 4.Exit: ");
        scanf("%d", &ch);
        if (ch == 1) {
            if (top == MAX - 1) { printf("Full\n"); continue; }
            printf("Value: ");
            scanf("%d", &x);
            s[++top] = x;           // push into stack
            q[++rear] = x;          // enqueue into queue
        } else if (ch == 2) {
            if (top == -1) { printf("Empty\n"); continue; }
            printf("Stack removed %d (last in), Queue removed %d (first in)\n", s[top--], q[front++]);
            if (front > rear) { front = 0; rear = -1; }
        } else if (ch == 3) {
            printf("Stack (top->bottom): ");
            for (int i = top; i >= 0; i--) printf("%d ", s[i]);
            printf("\nQueue (front->rear): ");
            for (int i = front; i <= rear; i++) printf("%d ", q[i]);
            printf("\n");
        } else break;
    }
    return 0;
}

