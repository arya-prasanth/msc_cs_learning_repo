// Reverse an array using recursion
#include <stdio.h>
void rev(int a[], int i, int j) {
    if (i >= j) return;            // base case
    int t = a[i]; a[i] = a[j]; a[j] = t;
    rev(a, i + 1, j - 1);
}
int main() {
    int a[50], n;
    printf("Enter n: ");
    scanf("%d", &n);
    printf("Enter elements: ");
    for (int i = 0; i < n; i++) scanf("%d", &a[i]);
    rev(a, 0, n - 1);
    printf("Reversed: ");
    for (int i = 0; i < n; i++) printf("%d ", a[i]);
    printf("\n");
    return 0;
}

