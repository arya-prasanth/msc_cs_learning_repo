// BST postorder traversal without recursion (using two stacks)
#include <stdio.h>
#include <stdlib.h>
struct node { int data; struct node *left, *right; };

struct node *insert(struct node *r, int x) {
    if (r == NULL) {
        r = (struct node *)malloc(sizeof(struct node));
        r->data = x; r->left = r->right = NULL;
    } else if (x < r->data) r->left = insert(r->left, x);
    else r->right = insert(r->right, x);
    return r;
}
int main() {
    struct node *root = NULL, *cur, *s1[50], *s2[50];
    int n, x, t1 = -1, t2 = -1;
    printf("How many nodes? ");
    scanf("%d", &n);
    printf("Enter values: ");
    for (int i = 0; i < n; i++) { scanf("%d", &x); root = insert(root, x); }
    if (root) s1[++t1] = root;
    while (t1 >= 0) {
        cur = s1[t1--];
        s2[++t2] = cur;                            // s2 collects root-right-left order
        if (cur->left)  s1[++t1] = cur->left;
        if (cur->right) s1[++t1] = cur->right;
    }
    printf("Postorder: ");
    while (t2 >= 0) printf("%d ", s2[t2--]->data);  // reversing gives left-right-root
    printf("\n");
    return 0;
}

