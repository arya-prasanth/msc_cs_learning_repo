// Graph representation using adjacency list (linked list), undirected
#include <stdio.h>
#include <stdlib.h>
struct node { int v; struct node *next; };

void add(struct node *adj[], int a, int b) {
    struct node *t = (struct node *)malloc(sizeof(struct node));
    t->v = b; t->next = adj[a]; adj[a] = t;       // insert at head of a's list
}
int main() {
    struct node *adj[10] = {NULL}, *p;
    int v, e, a, b;
    printf("Number of vertices: ");
    scanf("%d", &v);
    printf("Number of edges: ");
    scanf("%d", &e);
    for (int i = 0; i < e; i++) {
        printf("Edge %d (two vertices, 0 to %d): ", i + 1, v - 1);
        scanf("%d %d", &a, &b);
        add(adj, a, b);
        add(adj, b, a);
    }
    printf("\nAdjacency list:\n");
    for (int i = 0; i < v; i++) {
        printf("%d: ", i);
        for (p = adj[i]; p; p = p->next) printf("%d -> ", p->v);
        printf("NULL\n");
    }
    return 0;
}
