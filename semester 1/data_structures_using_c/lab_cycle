// Insertion in a singly linked list: beginning, end, position
#include <stdio.h>
#include <stdlib.h>
struct node { int data; struct node *next; };
struct node *head = NULL;

struct node *newnode(int x) {
    struct node *t = (struct node *)malloc(sizeof(struct node));
    t->data = x; t->next = NULL;
    return t;
}
void display() {
    for (struct node *p = head; p; p = p->next) printf("%d -> ", p->data);
    printf("NULL\n");
}
int main() {
    int ch, x, pos;
    struct node *t, *p;
    while (1) {
        printf("\n1.Insert begin 2.Insert end 3.Insert at position 4.Display 5.Exit: ");
        scanf("%d", &ch);
        if (ch == 5) break;
        if (ch == 4) { display(); continue; }
        printf("Value: ");
        scanf("%d", &x);
        t = newnode(x);
        if (ch == 1) { t->next = head; head = t; }
        else if (ch == 2) {
            if (head == NULL) head = t;
            else { for (p = head; p->next; p = p->next); p->next = t; }
        } else if (ch == 3) {
            printf("Position: ");
            scanf("%d", &pos);
            if (pos == 1) { t->next = head; head = t; }
            else {
                p = head;
                for (int i = 1; i < pos - 1 && p; i++) p = p->next;
                if (p == NULL) { printf("Invalid position\n"); free(t); }
                else { t->next = p->next; p->next = t; }
            }
        }
    }
    return 0;
}

