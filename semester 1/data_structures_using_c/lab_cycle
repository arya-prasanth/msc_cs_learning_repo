// 2D matrix operations (n x n) - menu driven
#include <stdio.h>
int n, A[10][10], B[10][10], R[10][10];

void read(int m[10][10]) {
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++) scanf("%d", &m[i][j]);
}
void show() {
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) printf("%d\t", R[i][j]);
        printf("\n");
    }
}
int main() {
    int ch;
    printf("Order of matrix (n): ");
    scanf("%d", &n);
    printf("Enter matrix A:\n"); read(A);
    printf("Enter matrix B:\n"); read(B);
    while (1) {
        printf("\n1.Add 2.Subtract 3.Multiply 4.Transpose of A 5.Exit: ");
        scanf("%d", &ch);
        if (ch == 5) break;
        for (int i = 0; i < n; i++)
            for (int j = 0; j < n; j++) {
                if (ch == 1) R[i][j] = A[i][j] + B[i][j];
                else if (ch == 2) R[i][j] = A[i][j] - B[i][j];
                else if (ch == 3) {
                    R[i][j] = 0;
                    for (int k = 0; k < n; k++) R[i][j] += A[i][k] * B[k][j];
                } else if (ch == 4) R[i][j] = A[j][i];
            }
