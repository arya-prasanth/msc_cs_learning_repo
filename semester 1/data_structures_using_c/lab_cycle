// BST preorder traversal without recursion (using a stack)
#include <stdio.h>
#include <stdlib.h>
struct node { int data; struct node *left, *right; };

struct node *insert(struct node *r, int x) {
    if (r == NULL) {
        r = (struct node *)malloc(sizeof(struct node));
        r->data = x; r->left = r->right = NULL;
    } else if (x < r->data) r->left = insert(r->left, x);
    else r->right = insert(r->right, x);
    return r;
}
int main() {
    struct node *root = NULL, *cur, *st[50];
    int n, x, top = -1;
    printf("How many nodes? ");
    scanf("%d", &n);
    printf("Enter values: ");
    for (int i = 0; i < n; i++) { scanf("%d", &x); root = insert(root, x); }
    printf("Preorder: ");
    if (root) st[++top] = root;
    while (top >= 0) {
        cur = st[top--];
        printf("%d ", cur->data);
        if (cur->right) st[++top] = cur->right;   // push right first so left is processed first
        if (cur->left)  st[++top] = cur->left;
    }
    printf("\n");
    return 0;
}

